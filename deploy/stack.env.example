# Variables of the production stack (deploy/docker-compose.yml).
# In Portainer: paste these under "Environment variables" of the stack (Advanced mode), with
# real values. Never commit real values.

# ---- Required ----
# Database password. Do not use ";" in it.
POSTGRES_PASSWORD=
# Signing key for access tokens: 32 or more random characters, e.g. from `openssl rand -base64 48`.
# Changing it later signs every user out.
JWT_KEY=

# ---- First user (new installation only) ----
# Creates the Owner of this shop the first time the API starts. Users type the tenant id when
# they sign in, so keep it: generate one with `uuidgen` or any UUID generator.
# After the first successful sign-in, remove BOOTSTRAP_OWNER_PASSWORD from the stack.
BOOTSTRAP_TENANT_ID=
BOOTSTRAP_OWNER_EMAIL=
# At least 12 characters.
BOOTSTRAP_OWNER_PASSWORD=

# ---- Optional ----
# Image version. The deploy workflow sets this to the commit's tag (sha-xxxxxxxxxxxx) when it
# deploys through the Portainer API. Set an older tag here to roll back.
IMAGE_TAG=latest
# Change only if the images are published somewhere else.
IMAGE_REGISTRY=ghcr.io/picthaisky
# Host port of the web app. Point your HTTPS reverse proxy at it.
WEB_PORT=8080
# Number of proxies in front of the API: nginx of this stack plus your HTTPS reverse proxy.
# Used to find the real client address for sign-in rate limiting. Use 1 with no outer proxy.
FORWARD_LIMIT=2
# Database backups kept on this server.
# A dump every BACKUP_INTERVAL_HOURS, deleted after BACKUP_KEEP_DAYS; plus one before each
# deployment, of which the newest BACKUP_KEEP_PREDEPLOY are kept.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_PREDEPLOY=5
# Copy of every backup outside this server, in S3-compatible storage (deploy/README.md).
# Off while BACKUP_S3_BUCKET is empty: then a lost server loses the backups too.
# The bucket must exist and be private. Use an access key that can only reach this bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# The storage's S3 address, e.g. https://<account>.r2.cloudflarestorage.com (Cloudflare R2),
# https://s3.us-west-004.backblazeb2.com (Backblaze B2). Leave empty for AWS S3.
BACKUP_S3_ENDPOINT=
# Needed by AWS S3 (e.g. ap-southeast-1); most others accept it empty or "auto".
BACKUP_S3_REGION=
# AWS, Cloudflare, Backblaze, Wasabi, Minio, ... or Other (works with most).
BACKUP_S3_PROVIDER=Other
# Folder inside the bucket.
BACKUP_S3_PREFIX=senic-pos
# Off-site copies older than this are deleted. 0 = keep for ever.
BACKUP_OFFSITE_KEEP_DAYS=90
# Time zone that report days and date filters follow.
BUSINESS_TIMEZONE=Asia/Bangkok

# Push notifications (all three or none). Keys: `npx web-push generate-vapid-keys`.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=

# Rendered at container start: ${API_UPSTREAM} is replaced with the environment variable.
# Serving the app and the API from one origin means no CORS, and the refresh-token cookie
# (SameSite=Strict, Path=/api/auth) is sent without any extra configuration.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # The API's health endpoint, exposed so a deployment can check the stack from outside:
    # it answers only when nginx, the API and (at start-up) the database are all working.
    location = /health {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        add_header Cache-Control "no-store";
    }

    # API and SignalR hubs
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /hubs/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # Vite puts a content hash in every file name under /assets, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # These must always be revalidated, or browsers would keep running an old version:
    # the service worker and its manifest decide what the app updates to.
    location ~ ^/(index\.html|sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Single-page app: any other path is a client-side route.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}

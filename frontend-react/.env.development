# Base URL the browser uses for API calls. Keep "/api" to go through the Vite dev proxy
# (or the same-origin reverse proxy in production).
VITE_API_URL=/api

# Dev proxy target: http://localhost:5000 for docker-compose, http://localhost:5247 for `dotnet run`.
VITE_PROXY_TARGET=http://localhost:5000

# Dev only. "true" answers /api/auth/* from src/mocks because the backend has no authentication
# yet. Set to "false" once AuthController exists. Ignored in production builds.
VITE_USE_MOCKS=true
